# Optional. Base URL of the market-data backend (backend/), e.g. for running
# it on a different host/port than the vite dev proxy assumes. When unset,
# requests go same-origin through the vite proxy (/api, /ws -> localhost:3000).
# VITE_API_URL=http://localhost:3000

# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Fernet key used to encrypt exchange API credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Secret used to sign JWT access tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Password for the docker-compose "postgres" service (and the backend/
# etf-scraper DATABASE_URL that connects to it). No default — docker compose
# fails fast if this is unset. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
